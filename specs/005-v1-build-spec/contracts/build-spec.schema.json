{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "build-spec.schema.json",
  "title": "V1 Build Specification",
  "description": "Governed deterministic BuildSpec 2.0.0 consumed by the Formula Compiler",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "buildSpecId",
    "architectureId",
    "architectureContentSha256",
    "caseId",
    "ruleSetVersion",
    "generatedAt",
    "architectureLineage",
    "formulas",
    "namedRanges",
    "cellMappings",
    "executionOrder",
    "validation",
    "buildSpecContentSha256"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "buildSpecId": {
      "type": "string",
      "format": "uuid"
    },
    "architectureId": {
      "type": "string",
      "format": "uuid"
    },
    "architectureContentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "caseId": {
      "type": "string",
      "format": "uuid"
    },
    "ruleSetVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "architectureLineage": { "$ref": "#/$defs/ArchitectureLineage" },
    "formulas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FormulaDefinition"
      }
    },
    "namedRanges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NamedRangeDefinition"
      }
    },
    "cellMappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CellMapping"
      }
    },
    "executionOrder": {
      "$ref": "#/$defs/ExecutionOrder"
    },
    "validation": {
      "$ref": "#/$defs/ValidationResult"
    },
    "buildSpecContentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "FormulaDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formulaId",
        "scenarioId",
        "tabName",
        "genericField",
        "formulaText",
        "cellAddress",
        "dependencies",
        "iobClassification",
        "justification",
        "formulaKind",
        "provenance"
      ],
      "properties": {
        "formulaId": {
          "type": "string",
          "pattern": "^FORMULA-.+$"
        },
        "scenarioId": {
          "type": "string"
        },
        "tabName": {
          "type": "string"
        },
        "genericField": {
          "type": "string",
          "minLength": 1
        },
        "formulaText": {
          "type": "string"
        },
        "cellAddress": {
          "type": "string",
          "pattern": "^\\$?[A-Z]{1,3}\\$?[1-9][0-9]{0,6}$"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "iobClassification": {
          "type": "string",
          "enum": ["I", "O", "B", "N", "P", ""]
        },
        "justification": {
          "type": "string"
        },
        "formulaKind": {
          "const": "scalar"
        },
        "provenance": {
          "$ref": "#/$defs/FormulaProvenance"
        }
      }
    },
    "FormulaProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePlanRules",
        "derivationDescription",
        "formulaApproval",
        "affectedTestIds",
        "regenerationImpact",
        "validationOracleIds"
      ],
      "properties": {
        "sourcePlanRules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/FormulaRuleProvenance" }
        },
        "derivationDescription": { "type": "string", "minLength": 1 },
        "formulaApproval": { "$ref": "#/$defs/FormulaApprovalRecord" },
        "affectedTestIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "regenerationImpact": { "type": "string", "minLength": 1 },
        "validationOracleIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "FormulaRuleProvenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "ruleId",
        "ruleContentSha256",
        "relationship",
        "citation",
        "effectiveDate",
        "endDate",
        "adoptionOrExecutionDate",
        "applicabilityConditions",
        "supersedesRuleId",
        "confidence",
        "reviewStatus",
        "authorityOverrideId",
        "unresolvedItemIds",
        "linkedUnresolvedItemIds"
      ],
      "properties": {
        "ruleId": { "type": "string", "format": "uuid" },
        "ruleContentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "relationship": { "enum": ["governing", "supporting"] },
        "citation": { "$ref": "#/$defs/FormulaCitation" },
        "effectiveDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "endDate": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "adoptionOrExecutionDate": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "applicabilityConditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["dimension", "value"],
            "properties": {
              "dimension": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        },
        "supersedesRuleId": { "type": ["string", "null"], "format": "uuid" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewStatus": { "enum": ["human-approved", "provisional"] },
        "authorityOverrideId": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "unresolvedItemIds": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" },
          "uniqueItems": true
        },
        "linkedUnresolvedItemIds": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" },
          "uniqueItems": true
        }
      }
    },
    "FormulaApprovalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "decisionContentSha256", "appendOrdinal", "priorDecisionId", "priorDecisionContentSha256", "decisionType", "resultingStatus", "formulaText", "target", "scenarioId", "iobClassification", "sourcePlanRules", "derivationDescription", "affectedTestIds", "regenerationImpact", "validationOracleIds", "humanActor", "rationale", "decidedAt", "schemaVersion"],
      "properties": {
        "decisionId": { "type": "string", "format": "uuid" },
        "decisionContentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "appendOrdinal": { "type": "integer", "minimum": 1 },
        "priorDecisionId": { "type": ["string", "null"], "format": "uuid" },
        "priorDecisionContentSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "decisionType": { "enum": ["approve", "revoke", "supersede"] },
        "resultingStatus": { "enum": ["approved", "revoked", "superseded"] },
        "formulaText": { "type": "string", "minLength": 1 },
        "target": { "type": "object", "required": ["tabName", "cellAddress", "genericField"], "properties": { "tabName": { "type": "string", "minLength": 1 }, "cellAddress": { "type": "string", "pattern": "^\\$?[A-Z]{1,3}\\$?[1-9][0-9]{0,6}$" }, "genericField": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
        "scenarioId": { "type": "string", "minLength": 1 },
        "iobClassification": { "enum": ["O", "B"] },
        "sourcePlanRules": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["ruleId", "ruleContentSha256", "relationship"], "properties": { "ruleId": { "type": "string", "format": "uuid" }, "ruleContentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "relationship": { "enum": ["governing", "supporting"] } }, "additionalProperties": false } },
        "derivationDescription": { "type": "string", "minLength": 1 },
        "affectedTestIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "regenerationImpact": { "type": "string", "minLength": 1 },
        "validationOracleIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "humanActor": { "$ref": "#/$defs/HumanActor" },
        "rationale": { "type": "string", "minLength": 1 },
        "decidedAt": { "type": "string", "format": "date-time" },
        "schemaVersion": { "const": "1.0.0" }
      }
    },
    "FormulaCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactSha256", "sourceRole", "locator"],
      "properties": {
        "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceRole": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 }
      }
    },
    "HumanActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorType", "actorKey", "displayName", "authorityContext"],
      "properties": {
        "actorType": { "const": "human" },
        "actorKey": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "authorityContext": { "type": "string", "minLength": 1 }
      }
    },
    "NamedRangeDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rangeName",
        "cellAddress",
        "tabName",
        "scope",
        "genericField",
        "scenarioId",
        "provenance"
      ],
      "properties": {
        "rangeName": {
          "type": "string"
        },
        "cellAddress": {
          "type": "string",
          "pattern": "^\\$?[A-Z]{1,3}\\$?[1-9][0-9]{0,6}$"
        },
        "tabName": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": ["workbook", "sheet"]
        },
        "genericField": {
          "type": ["string", "null"]
        },
        "scenarioId": {
          "type": ["string", "null"]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "architectureNamedRange"],
          "properties": {
            "source": {
              "const": "architecture"
            },
            "architectureNamedRange": {
              "type": "string"
            }
          }
        }
      }
    },
    "CellMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mappingId",
        "field",
        "tabName",
        "cellAddress",
        "iobClassification",
        "dataSource",
        "formulaId",
        "scenarioId"
      ],
      "properties": {
        "mappingId": {
          "type": "string",
          "format": "uuid"
        },
        "field": {
          "type": "string"
        },
        "tabName": {
          "type": "string"
        },
        "cellAddress": {
          "type": "string",
          "pattern": "^\\$?[A-Z]{1,3}\\$?[1-9][0-9]{0,6}$"
        },
        "iobClassification": {
          "type": "string",
          "enum": ["I", "O", "B", "N", "P", ""]
        },
        "dataSource": {
          "oneOf": [
            { "$ref": "#/$defs/DataSourceReference" },
            { "type": "null" }
          ]
        },
        "formulaId": {
          "type": ["string", "null"]
        },
        "scenarioId": {
          "type": "string"
        }
      }
    },
    "DataSourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "sourceTab", "sourceField", "evidenceKey"],
      "properties": {
        "sourceType": {
          "type": "string",
          "enum": ["population", "case-control", "evidence"]
        },
        "sourceTab": {
          "type": "string"
        },
        "sourceField": {
          "type": "string"
        },
        "evidenceKey": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "ArchitectureLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policies", "evidenceCatalogId", "evidenceCatalogContentSha256", "population", "caseControls", "authorityOverrides"],
      "properties": {
        "policies": { "type": "array", "items": { "$ref": "#/$defs/ArchitecturePolicyLineage" } },
        "evidenceCatalogId": { "type": "string", "format": "uuid" },
        "evidenceCatalogContentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "population": { "type": "array", "items": { "$ref": "#/$defs/PopulationArchitectureLineage" } },
        "caseControls": { "type": "array", "items": { "$ref": "#/$defs/ContentIdentity" } },
        "authorityOverrides": { "type": "array", "items": { "$ref": "#/$defs/OverrideContentIdentity" } }
      }
    },
    "ArchitecturePolicyLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyKind", "policyVersion", "policyContentSha256", "sourceFileSha256", "approvalDecisionId", "approvalDecisionContentSha256"],
      "properties": {
        "policyKind": { "enum": ["scenario-selection", "tab-selection", "iob-classification", "field-name-glossary"] },
        "policyVersion": { "type": "string", "minLength": 1 },
        "policyContentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceFileSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "approvalDecisionId": { "type": "string", "format": "uuid" },
        "approvalDecisionContentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "PopulationArchitectureLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateKey", "artifactSha256", "workbookProfileContentSha256", "approvalDecisionId", "approvalDecisionContentSha256"],
      "properties": {
        "candidateKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "workbookProfileContentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "approvalDecisionId": { "type": "string", "minLength": 1 },
        "approvalDecisionContentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "ContentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlId", "contentSha256"],
      "properties": {
        "controlId": { "type": "string", "format": "uuid" },
        "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "OverrideContentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overrideId", "contentSha256"],
      "properties": {
        "overrideId": { "type": "string", "format": "uuid" },
        "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "ExecutionOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "levelCount",
        "maxDepth",
        "hasCycles",
        "cycleNodes"
      ],
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "levelCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0
        },
        "hasCycles": {
          "type": "boolean"
        },
        "cycleNodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ValidationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isValid", "errors", "warnings", "validatedAt"],
      "properties": {
        "isValid": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValidationError"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValidationWarning"
          }
        },
        "validatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ValidationError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "field", "formulaId", "context"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "ARCHITECTURE_HASH_MISMATCH",
            "ARCHITECTURE_INVALID",
            "ARCHITECTURE_RULE_SET_MISMATCH",
            "MISSING_FORMULA",
            "DUPLICATE_FORMULA",
            "DUPLICATE_MAPPING",
            "DUPLICATE_RANGE",
            "FORMULA_GOVERNANCE_INVALID",
            "FORMULA_PROVENANCE_INVALID",
            "UNSATISFIED_DEPENDENCY",
            "CIRCULAR_DEPENDENCY",
            "INVALID_CELL_ADDRESS",
            "MAPPING_MISMATCH",
            "MISSING_DATA_SOURCE",
            "SCHEMA_VALIDATION_FAILED"
          ]
        },
        "message": {
          "type": "string"
        },
        "field": {
          "type": ["string", "null"]
        },
        "formulaId": {
          "type": ["string", "null"]
        },
        "context": {
          "type": "object"
        }
      }
    },
    "ValidationWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "field", "context"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["DEEP_DEPENDENCY", "LARGE_FORMULA"]
        },
        "message": {
          "type": "string"
        },
        "field": {
          "type": ["string", "null"]
        },
        "context": {
          "type": "object"
        }
      }
    }
  }
}
