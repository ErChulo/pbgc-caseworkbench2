{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbgc-case-workbench.local/schemas/provision-candidate.schema.json",
  "title": "Provision Candidate",
  "description": "A proposal-only, locator-anchored extraction. Traces to exactly one EvidenceArtifact and an exact locator. Never final without authorized human approval; approval produces a PlanRuleRecord, not a status change on this candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidateId", "artifactSha256", "artifactLocator", "provisionIdentifier", "verbatimText", "normalizedRestatement", "extractedEffectiveDate", "extractedAdoptionDate", "dateExtractionConvention", "confidence", "classifierId", "classifierVersion", "ruleSetVersion", "status", "candidateContentSha256"],
  "properties": {
    "candidateId": { "$ref": "governed-records.schema.json#/$defs/uuid" },
    "artifactSha256": { "$ref": "governed-records.schema.json#/$defs/sha256" },
    "artifactLocator": { "type": "string", "minLength": 1 },
    "provisionIdentifier": { "type": "string", "minLength": 1 },
    "verbatimText": { "type": "string", "minLength": 1 },
    "normalizedRestatement": { "type": "string", "minLength": 1 },
    "extractedEffectiveDate": { "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }] },
    "extractedAdoptionDate": { "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }] },
    "dateExtractionConvention": { "enum": ["explicit", "inferred-from-context", "unknown"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "classifierId": { "type": "string", "minLength": 1 },
    "classifierVersion": { "type": "string", "minLength": 1 },
    "ruleSetVersion": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposed", "unresolved"] },
    "candidateContentSha256": { "$ref": "governed-records.schema.json#/$defs/sha256" },
    "linkedUnresolvedItemIds": { "type": "array", "items": { "$ref": "governed-records.schema.json#/$defs/uuid" } }
  },
  "if": { "properties": { "status": { "const": "unresolved" } }, "required": ["status"] },
  "then": { "required": ["linkedUnresolvedItemIds"] },
  "not": {
    "description": "A candidate may never declare an approved status. Approval produces a separate PlanRuleRecord.",
    "properties": { "status": { "const": "approved" } },
    "required": ["status"]
  }
}
