{
  "name": "pbgc-caseworkbench-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check package.json tsconfig.json eslint.config.js vite.config.ts vitest.config.ts playwright.config.ts web docs/feature-009-browser-feasibility.md docs/feature-009-dependency-review.md docs/adr/009-local-first-evidence-intake.md",
    "validate:schemas": "node web/tools/validate-design-schemas.mjs",
    "validate:contracts": "node web/tools/validate-contracts.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project contract --project worker",
    "test:integration": "vitest run --project integration",
    "test:browser:e2e": "playwright test",
    "test:browser:chromium": "playwright test --project=chromium",
    "build": "vite build",
    "verify:single-file": "node web/tools/verify-single-file.mjs",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm run validate:schemas && npm run validate:contracts && npm test && npm run build && npm run verify:single-file"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "hash-wasm": "4.12.0",
    "pdfjs-dist": "6.1.200",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/node": "26.1.1",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "3.2.7"
  }
}
